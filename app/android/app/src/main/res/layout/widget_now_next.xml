<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 2×2: «Сейчас / Далее». Номер аудитории — на табличке цвета предмета, самый крупный элемент. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
        style="@style/W.Label"
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_highlight"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />
        <TextView
        style="@style/W.Button"
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>
    <TextView
    style="@style/W.Row"
        android:id="@+id/subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:textSize="14sp" />
    <TextView
    style="@style/W.RoomBig"
        android:id="@+id/room"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="8dp"
        android:background="@drawable/widget_plate"
        android:backgroundTint="@color/widget_accent"
        android:textColor="@color/widget_bg"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="22sp"
        android:autoSizeMaxTextSize="46sp"
        android:paddingHorizontal="6dp" />
    <!-- Для длинных названий («3 корпус», «спортзал», «читальный зал (1 этаж)»): та же табличка, но текст мельче и в две строки -->
    <TextView
    style="@style/W.RoomBig"
        android:id="@+id/room_long"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="8dp"
        android:background="@drawable/widget_plate"
        android:backgroundTint="@color/widget_accent"
        android:textColor="@color/widget_bg"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="24sp"
        android:maxLines="2"
        android:visibility="gone"
        android:paddingHorizontal="8dp" />
    <Chronometer
    style="@style/W.Second"
        android:id="@+id/countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />
    <TextView
    style="@style/W.Second"
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="13sp" />
</LinearLayout>
